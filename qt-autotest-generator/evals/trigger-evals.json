      "id": "zh-scan-importance",
      "input": "扫描函数重要性",
      "expected": true,
      "reason": "Mode 1 触发语"
    },
    {
      "id": "zh-gen-inventory",
      "input": "生成 inventory",
      "expected": true,
      "reason": "Mode 1 触发语"
    },
    {
      "id": "zh-probe-level",
      "input": "探测分级",
      "expected": true,
      "reason": "Mode 1 触发语"
    },
    {
      "id": "zh-init-analysis",
      "input": "项目初始化单测分析",
      "expected": true,
      "reason": "Mode 1 触发语"
    },
    {
      "id": "en-scan-importance",
      "input": "scan method importance",
      "expected": true,
      "reason": "Mode 1 英文触发语"
    },
    {
      "id": "en-importance-inventory",
      "input": "importance inventory",
      "expected": true,
      "reason": "Mode 1 英文触发语"
    },
    {
      "id": "zh-gen-tests",
      "input": "生成单测",
      "expected": true,
      "reason": "核心触发语"
    },
    {
      "id": "zh-build-framework",
      "input": "建测试框架",
      "expected": true,
      "reason": "核心触发语"
    },
    {
      "id": "zh-batch-gen",
      "input": "批量生成单测",
      "expected": true,
      "reason": "核心触发语"
    },
    {
